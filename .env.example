# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ptp"

# Encrypts the session cookie. At least 32 random characters:
#   openssl rand -base64 32
SESSION_PASSWORD=""

# Public URL of the app, used for Stripe redirect URLs
APP_URL="http://localhost:3000"

# Optional. Without these, bookings are confirmed immediately with no payment.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
