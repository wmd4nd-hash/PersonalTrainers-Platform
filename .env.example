# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ptp"

# Encrypts the session cookie. At least 32 random characters:
#   openssl rand -base64 32
SESSION_PASSWORD=""

# Optional. Without SMTP_URL, emails are logged and kept in the admin outbox
# instead of being sent. Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=""
EMAIL_FROM="PT Platform <no-reply@example.com>"
# Bearer token for /api/cron/* (required in production; see docs/OPERATIONS.md)
CRON_SECRET=""

# Public URL of the app, used for Stripe redirect URLs
APP_URL="http://localhost:3000"

# Optional. Without these, payments are simulated (no money is taken). On a
# production build that only works with DEMO_MODE=true.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Signing secret of the Connect webhook endpoint (events from trainers' accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=""

# "true" allows simulated payments on a production build (a public demo).
DEMO_MODE=""
# "true" allows `npm run db:seed` on a production build. The demo accounts,
# including an admin, all use the password "password123".
ALLOW_DEMO_SEED=""
